# ==========================================
# TEMPLATE KONFIGURASI ENVIRONMENT (.env.example)
# ==========================================
# Salin file ini menjadi:
# - .env.development (untuk local dev)
# - .env.staging     (untuk server staging / UAT)
# - .env.production  (untuk server production)
# Atau simpan sebagai .env
# ==========================================

# Environment Mode: development | staging | production | testing
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here
PORT=5001

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=book_finder_db

# Google Books API Key (Opsional)
GOOGLE_BOOKS_API_KEY=
